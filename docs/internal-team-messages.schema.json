{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vipclub.example/schemas/internal-team-messages.schema.json",
  "title": "Internal Team Complaint or Compliment",
  "description": "Audited employee-to-team-member complaint/compliment record with type-specific delivery and visibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageId",
    "sourceType",
    "messageType",
    "senderEmployeeId",
    "subjectEmployeeId",
    "branchId",
    "text",
    "createdAt",
    "deliveryStates",
    "readStates",
    "moderationReviewStatus",
    "senderConfirmationState",
    "attachments",
    "routing",
    "auditHistory"
  ],
  "properties": {
    "messageId": {"type": "string", "minLength": 1},
    "sourceType": {"const": "internal_team"},
    "messageType": {"enum": ["complaint", "compliment"]},
    "senderEmployeeId": {"type": "string", "minLength": 1},
    "subjectEmployeeId": {"type": "string", "minLength": 1},
    "branchId": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "deliveryStates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["audienceType", "recipientId", "state", "updatedAt"],
        "properties": {
          "audienceType": {"enum": ["ceo", "authorized_branch_manager", "compliment_recipient"]},
          "recipientId": {"type": "string", "minLength": 1},
          "state": {"enum": ["pending", "delivered", "failed"]},
          "updatedAt": {"type": "string", "format": "date-time"}
        }
      }
    },
    "readStates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["audienceType", "recipientId", "state"],
        "properties": {
          "audienceType": {"enum": ["ceo", "authorized_branch_manager", "compliment_recipient"]},
          "recipientId": {"type": "string", "minLength": 1},
          "state": {"enum": ["unread", "read"]},
          "readAt": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "moderationReviewStatus": {"type": "string", "minLength": 1},
    "senderConfirmationState": {"enum": ["submitted", "failed"]},
    "attachments": {
      "type": "array",
      "description": "Empty until a later policy explicitly allows attachments.",
      "maxItems": 0,
      "items": {"type": "string", "minLength": 1}
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ceoCompanyWideAccess",
        "managerBranchId",
        "subjectCanView",
        "subjectCanRespond",
        "automaticRankingImpact"
      ],
      "properties": {
        "ceoCompanyWideAccess": {"const": true},
        "managerBranchId": {"type": "string", "minLength": 1},
        "subjectCanView": {"type": "boolean"},
        "subjectCanRespond": {"type": "boolean"},
        "automaticRankingImpact": {"const": false}
      }
    },
    "attitudeIncidentReviewReference": {"type": ["string", "null"]},
    "auditHistory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actorId", "action", "timestamp"],
        "properties": {
          "actorId": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "timestamp": {"type": "string", "format": "date-time"},
          "correctionOfAuditEventId": {"type": ["string", "null"]}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"messageType": {"const": "complaint"}}},
      "then": {
        "properties": {
          "routing": {
            "properties": {
              "subjectCanView": {"const": false},
              "subjectCanRespond": {"const": false}
            }
          },
          "deliveryStates": {
            "items": {
              "properties": {
                "audienceType": {"enum": ["ceo", "authorized_branch_manager"]}
              }
            }
          },
          "readStates": {
            "items": {
              "properties": {
                "audienceType": {"enum": ["ceo", "authorized_branch_manager"]}
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"messageType": {"const": "compliment"}}},
      "then": {
        "properties": {
          "routing": {
            "properties": {
              "subjectCanView": {"const": true}
            }
          }
        }
      }
    }
  ],
  "x-routing-rules": [
    "Every active employee/team member, including an entertainer, may submit either type.",
    "The server derives branchId and managerBranchId from the selected subject's current authorized team/branch context.",
    "Complaint content and review data are visible only to the CEO and managers authorized for managerBranchId.",
    "The complaint subject receives no delivery, cannot view the record, and cannot respond.",
    "The complaint sender receives submission confirmation only, not management-only review data.",
    "A compliment is delivered to the selected subject and is also visible to the CEO and managers authorized for managerBranchId.",
    "An internal complaint is distinct from the customer-complaints ranking factor and has no automatic score effect.",
    "An internal complaint may be referenced as attitude evidence only through a separate branch-manager-finalized attitude incident review."
  ],
  "x-open-policy-decisions": [
    "sender anonymity and confidentiality controls",
    "retention period",
    "appeal and escalation workflow",
    "compliment response rights",
    "whether and how attachments may be enabled"
  ]
}
