    <bpmn:sequenceFlow id="process-00-branch-setup_flow5" sourceRef="process-00-branch-setup_task4" targetRef="process-00-branch-setup_task5" />
    <bpmn:sequenceFlow id="process-00-branch-setup_flow6" sourceRef="process-00-branch-setup_task5" targetRef="process-00-branch-setup_end" />
  </bpmn:process>
