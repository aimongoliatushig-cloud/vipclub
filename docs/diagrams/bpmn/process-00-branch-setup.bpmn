  <bpmn:process id="process-00-branch-setup" name="Branch Setup and Activation" isExecutable="false">
    <bpmn:StartEvent id="process-00-branch-setup_start" name="Start" />
    <bpmn:Task id="process-00-branch-setup_task1" name="Create branch configuration" />
    <bpmn:Task id="process-00-branch-setup_task2" name="Apply approved defaults" />
    <bpmn:Task id="process-00-branch-setup_task3" name="Assign team and role scopes" />
    <bpmn:Task id="process-00-branch-setup_task4" name="Configure settings and reporting" />
    <bpmn:Task id="process-00-branch-setup_task5" name="Activate branch" />
    <bpmn:EndEvent id="process-00-branch-setup_end" name="Complete" />
    <bpmn:sequenceFlow id="process-00-branch-setup_flow1" sourceRef="process-00-branch-setup_start" targetRef="process-00-branch-setup_task1" />
