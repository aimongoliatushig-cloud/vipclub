  <bpmn:process id="process-41-complaint" name="Feedback and Complaint Handling" isExecutable="false">
    <bpmn:StartEvent id="process-41-complaint_start" name="Start" />
    <bpmn:Task id="process-41-complaint_task1" name="Submit feedback or complaint" />
    <bpmn:Task id="process-41-complaint_task2" name="Restrict and triage access" />
    <bpmn:Task id="process-41-complaint_task3" name="Investigate and assign action" />
    <bpmn:Task id="process-41-complaint_task4" name="Record response and resolution" />
    <bpmn:Task id="process-41-complaint_task5" name="Close and retain audit history" />
    <bpmn:EndEvent id="process-41-complaint_end" name="Complete" />
    <bpmn:sequenceFlow id="process-41-complaint_flow1" sourceRef="process-41-complaint_start" targetRef="process-41-complaint_task1" />
    <bpmn:sequenceFlow id="process-41-complaint_flow2" sourceRef="process-41-complaint_task1" targetRef="process-41-complaint_task2" />
    <bpmn:sequenceFlow id="process-41-complaint_flow3" sourceRef="process-41-complaint_task2" targetRef="process-41-complaint_task3" />
    <bpmn:sequenceFlow id="process-41-complaint_flow4" sourceRef="process-41-complaint_task3" targetRef="process-41-complaint_task4" />
    <bpmn:sequenceFlow id="process-41-complaint_flow5" sourceRef="process-41-complaint_task4" targetRef="process-41-complaint_task5" />
    <bpmn:sequenceFlow id="process-41-complaint_flow6" sourceRef="process-41-complaint_task5" targetRef="process-41-complaint_end" />
  </bpmn:process>
