    <bpmn:Task id="process-14-rank-evaluation_task2" name="Apply rank policy and gates" />
    <bpmn:Task id="process-14-rank-evaluation_task3" name="Calculate weighted score" />
    <bpmn:Task id="process-14-rank-evaluation_task4" name="Review proposed rank change" />
    <bpmn:Task id="process-14-rank-evaluation_task5" name="Record rank history and benefits" />
    <bpmn:EndEvent id="process-14-rank-evaluation_end" name="Complete" />
