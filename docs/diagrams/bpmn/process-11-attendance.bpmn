      <bpmndi:BPMNShape id="process-11-attendance_task8_di" bpmnElement="process-11-attendance_task8"><dc:Bounds x="1450" y="100" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="process-11-attendance_task9_di" bpmnElement="process-11-attendance_task9"><dc:Bounds x="1640" y="100" width="150" height="80" /></bpmndi:BPMNShape>
