<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_process-11-attendance" targetNamespace="https://vipclub.example/bpmn">
  <bpmn:process id="process-11-attendance" name="Branch Workforce Planning, Weekly Schedule and Attendance" isExecutable="false">
    <bpmn:StartEvent id="process-11-attendance_start" name="Start planning cycle" />
    <bpmn:Task id="process-11-attendance_task1" name="Maintain weekday and role staffing requirements" />
    <bpmn:Task id="process-11-attendance_task2" name="Build weekly team schedule" />
    <bpmn:Task id="process-11-attendance_task3" name="Validate required versus scheduled coverage" />
    <bpmn:Task id="process-11-attendance_task4" name="Resolve or record staffing shortage" />
    <bpmn:Task id="process-11-attendance_task5" name="Publish weekly schedule" />
    <bpmn:Task id="process-11-attendance_task6" name="Record verified check-in and check-out" />
    <bpmn:Task id="process-11-attendance_task7" name="Classify late, absence, and no-show" />
    <bpmn:Task id="process-11-attendance_task8" name="Manager reviews attendance exceptions" />
    <bpmn:Task id="process-11-attendance_task9" name="Publish verified attendance and readiness" />
    <bpmn:EndEvent id="process-11-attendance_end" name="Cycle complete" />

    <bpmn:sequenceFlow id="process-11-attendance_flow1" sourceRef="process-11-attendance_start" targetRef="process-11-attendance_task1" />
    <bpmn:sequenceFlow id="process-11-attendance_flow2" sourceRef="process-11-attendance_task1" targetRef="process-11-attendance_task2" />
    <bpmn:sequenceFlow id="process-11-attendance_flow3" sourceRef="process-11-attendance_task2" targetRef="process-11-attendance_task3" />
    <bpmn:sequenceFlow id="process-11-attendance_flow4" sourceRef="process-11-attendance_task3" targetRef="process-11-attendance_task4" />
    <bpmn:sequenceFlow id="process-11-attendance_flow5" sourceRef="process-11-attendance_task4" targetRef="process-11-attendance_task5" />
    <bpmn:sequenceFlow id="process-11-attendance_flow6" sourceRef="process-11-attendance_task5" targetRef="process-11-attendance_task6" />
    <bpmn:sequenceFlow id="process-11-attendance_flow7" sourceRef="process-11-attendance_task6" targetRef="process-11-attendance_task7" />
    <bpmn:sequenceFlow id="process-11-attendance_flow8" sourceRef="process-11-attendance_task7" targetRef="process-11-attendance_task8" />
    <bpmn:sequenceFlow id="process-11-attendance_flow9" sourceRef="process-11-attendance_task8" targetRef="process-11-attendance_task9" />
    <bpmn:sequenceFlow id="process-11-attendance_flow10" sourceRef="process-11-attendance_task9" targetRef="process-11-attendance_end" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="process-11-attendance_diagram">
    <bpmndi:BPMNPlane id="process-11-attendance_plane" bpmnElement="process-11-attendance">
      <bpmndi:BPMNShape id="process-11-attendance_start_di" bpmnElement="process-11-attendance_start"><dc:Bounds x="40" y="120" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="process-11-attendance_task1_di" bpmnElement="process-11-attendance_task1"><dc:Bounds x="120" y="100" width="150" height="80" /></bpmndi:BPMNShape>
