    <bpmn:Task id="process-11-attendance_task1" name="Assign schedule" />
    <bpmn:Task id="process-11-attendance_task2" name="Record check-in or check-out" />
    <bpmn:Task id="process-11-attendance_task3" name="Classify attendance" />
    <bpmn:Task id="process-11-attendance_task4" name="Review correction if required" />
    <bpmn:Task id="process-11-attendance_task5" name="Publish verified attendance" />
    <bpmn:EndEvent id="process-11-attendance_end" name="Complete" />
    <bpmn:sequenceFlow id="process-11-attendance_flow1" sourceRef="process-11-attendance_start" targetRef="process-11-attendance_task1" />
