  <bpmn:process id="process-17-loan-lifecycle" name="Income-Based Loan Lifecycle" isExecutable="false">
    <bpmn:StartEvent id="process-17-loan-lifecycle_start" name="Start" />
    <bpmn:Task id="process-17-loan-lifecycle_task1" name="Create eligibility snapshot" />
    <bpmn:Task id="process-17-loan-lifecycle_task2" name="Submit loan request" />
    <bpmn:Task id="process-17-loan-lifecycle_task3" name="Review and approve request" />
    <bpmn:Task id="process-17-loan-lifecycle_task4" name="Disburse approved amount" />
    <bpmn:Task id="process-17-loan-lifecycle_task5" name="Deduct repayment and reconcile balance" />
    <bpmn:EndEvent id="process-17-loan-lifecycle_end" name="Complete" />
    <bpmn:sequenceFlow id="process-17-loan-lifecycle_flow1" sourceRef="process-17-loan-lifecycle_start" targetRef="process-17-loan-lifecycle_task1" />
    <bpmn:sequenceFlow id="process-17-loan-lifecycle_flow2" sourceRef="process-17-loan-lifecycle_task1" targetRef="process-17-loan-lifecycle_task2" />
    <bpmn:sequenceFlow id="process-17-loan-lifecycle_flow3" sourceRef="process-17-loan-lifecycle_task2" targetRef="process-17-loan-lifecycle_task3" />
    <bpmn:sequenceFlow id="process-17-loan-lifecycle_flow4" sourceRef="process-17-loan-lifecycle_task3" targetRef="process-17-loan-lifecycle_task4" />
    <bpmn:sequenceFlow id="process-17-loan-lifecycle_flow5" sourceRef="process-17-loan-lifecycle_task4" targetRef="process-17-loan-lifecycle_task5" />
    <bpmn:sequenceFlow id="process-17-loan-lifecycle_flow6" sourceRef="process-17-loan-lifecycle_task5" targetRef="process-17-loan-lifecycle_end" />
  </bpmn:process>
