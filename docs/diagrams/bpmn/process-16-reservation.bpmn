      <bpmndi:BPMNShape id="process-16-reservation_task1_di" bpmnElement="process-16-reservation_task1"><dc:Bounds x="265" y="120" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="process-16-reservation_task2_di" bpmnElement="process-16-reservation_task2"><dc:Bounds x="450" y="120" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="process-16-reservation_task3_di" bpmnElement="process-16-reservation_task3"><dc:Bounds x="635" y="120" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="process-16-reservation_task4_di" bpmnElement="process-16-reservation_task4"><dc:Bounds x="820" y="120" width="140" height="80" /></bpmndi:BPMNShape>
