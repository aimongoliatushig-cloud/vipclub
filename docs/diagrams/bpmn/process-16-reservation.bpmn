      <bpmndi:BPMNEdge id="process-16-reservation_flow5_di" bpmnElement="process-16-reservation_flow5"><di:waypoint x="960" y="138" /><di:waypoint x="1005" y="138" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="process-16-reservation_flow6_di" bpmnElement="process-16-reservation_flow6"><di:waypoint x="1145" y="138" /><di:waypoint x="1190" y="138" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>