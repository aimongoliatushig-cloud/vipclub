<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_process-16-reservation" targetNamespace="https://vipclub.example/bpmn">
  <bpmn:process id="process-16-reservation" name="Reservation Lifecycle" isExecutable="false">
    <bpmn:StartEvent id="process-16-reservation_start" name="Start" />
    <bpmn:Task id="process-16-reservation_task1" name="Create reservation request" />
    <bpmn:Task id="process-16-reservation_task2" name="Check availability" />
    <bpmn:Task id="process-16-reservation_task3" name="Assign and confirm" />
    <bpmn:Task id="process-16-reservation_task4" name="Record arrival and completion" />
    <bpmn:Task id="process-16-reservation_task5" name="Attribute verified visit and revenue" />
    <bpmn:EndEvent id="process-16-reservation_end" name="Complete" />
    <bpmn:sequenceFlow id="process-16-reservation_flow1" sourceRef="process-16-reservation_start" targetRef="process-16-reservation_task1" />
    <bpmn:sequenceFlow id="process-16-reservation_flow2" sourceRef="process-16-reservation_task1" targetRef="process-16-reservation_task2" />
    <bpmn:sequenceFlow id="process-16-reservation_flow3" sourceRef="process-16-reservation_task2" targetRef="process-16-reservation_task3" />
    <bpmn:sequenceFlow id="process-16-reservation_flow4" sourceRef="process-16-reservation_task3" targetRef="process-16-reservation_task4" />
    <bpmn:sequenceFlow id="process-16-reservation_flow5" sourceRef="process-16-reservation_task4" targetRef="process-16-reservation_task5" />
    <bpmn:sequenceFlow id="process-16-reservation_flow6" sourceRef="process-16-reservation_task5" targetRef="process-16-reservation_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="process-16-reservation_diagram">
    <bpmndi:BPMNPlane id="process-16-reservation_plane" bpmnElement="process-16-reservation">
