      <bpmndi:BPMNEdge id="process-16-reservation_flow1_di" bpmnElement="process-16-reservation_flow1"><di:waypoint x="116" y="138" /><di:waypoint x="265" y="138" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="process-16-reservation_flow2_di" bpmnElement="process-16-reservation_flow2"><di:waypoint x="405" y="138" /><di:waypoint x="450" y="138" /></bpmndi:BPMNEdge>
