    <bpmn:Task id="process-43-payroll-bank-transfer_task3" name="Review adjustments and approve" />
    <bpmn:Task id="process-43-payroll-bank-transfer_task4" name="Create corporate bank batch" />
    <bpmn:Task id="process-43-payroll-bank-transfer_task5" name="Reconcile transfer result" />
    <bpmn:EndEvent id="process-43-payroll-bank-transfer_end" name="Complete" />
