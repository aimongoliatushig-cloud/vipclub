  <bpmn:process id="process-13-entertainer-settlement" name="Entertainer Three-Day Settlement" isExecutable="false">
    <bpmn:StartEvent id="process-13-entertainer-settlement_start" name="Start" />
    <bpmn:Task id="process-13-entertainer-settlement_task1" name="Collect verified sales and income" />
    <bpmn:Task id="process-13-entertainer-settlement_task2" name="Calculate shares and additions" />
    <bpmn:Task id="process-13-entertainer-settlement_task3" name="Apply penalties and loan repayment" />
    <bpmn:Task id="process-13-entertainer-settlement_task4" name="Review and approve settlement" />
    <bpmn:Task id="process-13-entertainer-settlement_task5" name="Record payment evidence" />
    <bpmn:EndEvent id="process-13-entertainer-settlement_end" name="Complete" />
