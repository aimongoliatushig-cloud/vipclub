{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vipclub.example/schemas/entertainer-ranking-shift-effort.schema.json",
  "title": "Entertainer Shift-Effort Daily Checklist",
  "description": "One audited seven-item checklist per entertainer, branch, shift, and scoring day.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entertainerId",
    "branchId",
    "shiftId",
    "scoringDate",
    "items",
    "completedCount",
    "missedCount",
    "componentScoreUnrounded",
    "weightedContributionUnrounded",
    "penaltySettingReference",
    "penaltyAmountPerMiss",
    "penaltyCurrency",
    "monetaryPenalty",
    "submittedBy",
    "submittedAt",
    "evidenceReferences",
    "financialCorrectionReversalLinks",
    "payoutLineItemReferences",
    "correctionHistory"
  ],
  "properties": {
    "entertainerId": {"type": "string", "minLength": 1},
    "branchId": {"type": "string", "minLength": 1},
    "shiftId": {"type": "string", "minLength": 1},
    "scoringDate": {"type": "string", "format": "date"},
    "items": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "completed"],
        "properties": {
          "itemId": {"type": "string", "minLength": 1},
          "completed": {"type": "boolean"},
          "evidenceReferences": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "notes": {"type": "string"}
        }
      }
    },
    "completedCount": {"type": "integer", "minimum": 0, "maximum": 7},
    "missedCount": {"type": "integer", "minimum": 0, "maximum": 7},
    "componentScoreUnrounded": {"type": "number", "minimum": 0, "maximum": 100},
    "weightedContributionUnrounded": {"type": "number", "minimum": 0, "maximum": 10},
    "penaltySettingReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branchId", "version", "effectiveFrom"],
      "properties": {
        "branchId": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "effectiveFrom": {"type": "string", "format": "date-time"}
      }
    },
    "penaltyAmountPerMiss": {"type": "number", "minimum": 0},
    "penaltyCurrency": {"type": "string", "minLength": 3, "maxLength": 3},
    "monetaryPenalty": {"type": "number", "minimum": 0},
    "submittedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "role", "authorizedBranchId"],
      "properties": {
        "userId": {"type": "string", "minLength": 1},
        "role": {"enum": ["branch_manager", "lead_entertainer"]},
        "authorizedBranchId": {"type": "string", "minLength": 1}
      }
    },
    "submittedAt": {"type": "string", "format": "date-time"},
    "evidenceReferences": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "financialCorrectionReversalLinks": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "payoutLineItemReferences": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "notes": {"type": "string"},
    "correctionHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actorUserId", "actorRole", "timestamp", "reason"],
        "properties": {
          "actorUserId": {"type": "string", "minLength": 1},
          "actorRole": {"enum": ["branch_manager", "lead_entertainer"]},
          "timestamp": {"type": "string", "format": "date-time"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "x-formulas": {
    "componentScoreUnrounded": "completedCount / 7 * 100",
    "weightedContributionUnrounded": "componentScoreUnrounded * 10 / 100",
    "monetaryPenalty": "missedCount * penaltyAmountPerMiss"
  },
  "x-cross-field-validations": [
    "Exactly seven unique itemId values are required and every completed value is boolean.",
    "completedCount equals the number of true item values.",
    "missedCount equals the number of false item values.",
    "completedCount plus missedCount equals 7.",
    "submittedBy.authorizedBranchId equals branchId and authorization is checked server-side.",
    "The uniqueness key is entertainerId, branchId, shiftId, and scoringDate; corrections preserve one canonical current record and audited history.",
    "Extra performances do not add checklist items or raise componentScoreUnrounded above 100.",
    "penaltySettingReference.branchId equals branchId and resolves the version effective for the scoring date/time.",
    "monetaryPenalty is retained with the checklist and is not recalculated when later penalty-setting versions are published.",
    "The shift-effort score/contribution and monetaryPenalty are separate outputs.",
    "The monetary penalty posts as an itemized entertainer three-day settlement/payout deduction linked back to this checklist and setting version.",
    "Unrounded values are retained until all eight weighted contributions are summed."
  ]
}
